# Frontend environment variables (Vite). Copy to `frontend/.env.local` and fill in
# real values for a deployed environment. Only variables prefixed with `VITE_` are
# exposed to the client bundle.
#
# For local development against the Firebase emulators you can leave these unset:
# `frontend/src/firebase.ts` falls back to safe "demo-*" placeholders and connects
# to the local emulator suite automatically (import.meta.env.DEV or localhost).

# --- Firebase web app config (read in frontend/src/firebase.ts) ---
# All seven are consumed by initializeApp(); each has an emulator-friendly default.
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# --- E2E build flag (read at build time in vite.config.ts, NOT at runtime) ---
# Set to "true" only for Playwright E2E builds (see Dockerfile.e2e). It gates the
# test-only mock PRF provider, which is dead-code-eliminated from production builds.
# Leave unset for normal development and production.
# VITE_E2E_HOOKS=true

# --- Currently unused ---
# VITE_GEOAPIFY_API_KEY is not read by any application code at present. Kept here as
# a placeholder for potential location-autocomplete features; safe to omit.
# VITE_GEOAPIFY_API_KEY=your_geoapify_api_key_here
